# LLM API configuration
# Copy this file to `.env` and fill in your key. Never commit `.env`.
#
# Any OpenAI-compatible endpoint works (DeepSeek / OpenAI / Moonshot / Qwen /
# OpenRouter / local Ollama/vLLM). LLM_* wins; the legacy DEEPSEEK_* names are
# still read as a fallback so existing .env files keep working unchanged.
LLM_API_KEY=sk-your-key-here
LLM_BASE_URL=https://api.deepseek.com
# Available models: deepseek-flash (reasoning, slower) / deepseek-v4-pro
LLM_MODEL=deepseek-flash
# LLM_TIMEOUT=30
#
# Optional fallback endpoint: used only on network/timeout/5xx failures, NEVER
# on a 4xx (so a bad key does not silently switch models).
# LLM_FALLBACK_API_KEY=
# LLM_FALLBACK_BASE_URL=
# LLM_FALLBACK_MODEL=

# ---- AI profile (fast | standard | deep) ----
# fast: one-line answers, no LLM for common questions; deep: strategy answers.
# PROFILE=standard

# ---- Audio devices (name fragments; see `py -3.12 voice_main.py --list-audio`) ----
# 留空（默认）= 跟随系统正在使用的设备：换耳机/换电脑零配置，拔插或切换
# 系统默认设备后，下一次录音/播报自动生效。想固定某个设备时填名字片段。
# AUDIO_INPUT=
# AUDIO_OUTPUT=

# ---- Voice link (optional; see README / SUMMARY_v3.md) ----
# STT_PROVIDER=cloud          # local | cloud | off (auto: cloud if key set, else local)
# STT_BASE_URL=               # OpenAI-compatible base, e.g. https://api.siliconflow.cn/v1
# STT_API_KEY=
# STT_MODEL=whisper-1         # cloud model: SiliconFlow SenseVoiceSmall / OpenAI whisper-1
# STT_LANGUAGE=zh
# STT_LOCAL_ENGINE=sensevoice # sensevoice (default, fast) | whisper; auto-falls back
# STT_LOCAL_MODEL=small       # whisper model size (tiny/base/small/medium)
# STT_LOCAL_THREADS=2         # cap CPU threads so the game keeps headroom
# ---- TTS (本地播报：SAPI 或 Piper，均输出 WAV，无需解码器) ----
# 默认 auto：优先用 SAPI（零依赖、即时；中文需系统中文语音包）。
# TTS_PROVIDER=sapi           # sapi | piper | off
# TTS_SAPI_VOICE=             # optional exact Windows voice name for sapi
# --- Piper（离线神经语音，实验性；需 pip install "piper-tts[zh]" + 模型 + g2pW 资源）---
# 中文标准普通话需要 pinyin/g2pW，首次使用会下载约 150MB 资源；
# 部分机器上 g2pW 初始化较慢/不稳定，故不作默认。
# TTS_PROVIDER=piper
# TTS_PIPER_VOICE=piper_models/zh_CN-huayan-medium.onnx

# ---- Tyre temperature alarm (T1.3) ----
# Inner-tyre median temperature considered "too hot" (Celsius). PLACEHOLDER:
# not yet calibrated against real replay data.
# TYRE_HOT_INNER_C=110

# ---- Proactive radio / race model / PTT (v2). See config_schema.py for the
# full list, ranges and defaults. All are optional; defaults apply when unset.
# RADIO_ENABLE=1                 # master switch for proactive radio
# RADIO_VERBOSITY=chatty         # minimal | normal | chatty
# RADIO_GAP_MODE=every_lap       # off | on_change | every_lap | every_n_laps
# RADIO_GATE_ENABLE=1            # only speak on straights
# RADIO_QUIET_POLICY=in_game     # in_game | force_on | force_off
# RADIO_BEEP=1
# RADIO_FILTER=1
# TYRE_WEAR_LIMIT_PCT=70
# PTT_MODE=toggle                # hold | toggle
# PTT_BINDING=kb:0x6B            # kb:<vk> | hid:VID:PID:byte:mask
# DRIVER_NAME_STYLE=zh           # zh | en | number
# DEBRIEF_ENABLE=1
# DEBRIEF_DIR=sessions
# CONFIG_UI_PORT=8766
